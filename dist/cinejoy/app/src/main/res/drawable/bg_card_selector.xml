<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (Fire TV remote selection) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="3dp" android:color="#0ea5e9" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Default normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151d30" />
            <stroke android:width="1dp" android:color="#1e293b" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
