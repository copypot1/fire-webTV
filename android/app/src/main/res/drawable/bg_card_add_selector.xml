<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <stroke android:width="3dp" android:color="#38BDF8" android:dashWidth="8dp" android:dashGap="4dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0d1424" />
            <stroke android:width="2dp" android:color="#334155" android:dashWidth="6dp" android:dashGap="4dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
